# Copiar a .env y ajustar si es necesario.
# Desarrollo local: SQLite (por defecto si no se define DATABASE_URL)
# DATABASE_URL=sqlite:///./swarm_lab.db

# Producción: PostgreSQL
# DATABASE_URL=postgresql+psycopg2://user:password@localhost/swarm_lab

# SSH por defecto para robots (panel de control y ejecución remota)
# SSH_USER=ubuntu
# SSH_PASSWORD=
